# 复制为 .env 后填入真实值
# cp .env.example .env

# LLM（聊天模型，如智谱 GLM）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=GLM-4.7-Flash
# 简单意图小模型；不填则与 LLM_MODEL 相同。演示双模型时可设 glm-4-flash
# LLM_MODEL_SIMPLE=
# LLM_ROUTE_FALLBACK_TO_LARGE=true
# LLM_ROUTE_CONFIDENCE_MIN=0.5

# Embedding（RAG 向量；不配则退回仅 JSON 关键词检索）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=sky_take_out

# Java 后端（可选对接）
JAVA_BACKEND_URL=http://localhost:8080
JAVA_ADMIN_USER=admin
JAVA_ADMIN_PASSWORD=123456

# 服务（可选，有默认值）
# APP_HOST=0.0.0.0
# APP_PORT=8100

# 工程护栏（面经阶段 1）
# MAX_TOOL_STEPS=4
# TOKEN_BUDGET=12000
# TOOL_TIMEOUT_SEC=20
# TOOL_MAX_RETRIES=2
# IDEMPOTENCY_TTL_SEC=600

# Supervisor（面经阶段 2）
# MAX_SUPERVISOR_ROUNDS=6

# Checkpointer（面经阶段 3）
# CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
# 演示断点时设为 tools（生产保持空）
# CHECKPOINT_INTERRUPT_AFTER=

# Redis / 限流 / 对话日志（面经阶段 4）
# REDIS_ENABLED=true
# REDIS_URL=redis://localhost:6379/0
# REDIS_SESSION_TTL_SEC=86400
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=30
# CHAT_LOG_ENABLED=true

# 安全（面经阶段 5）
# SECURITY_INJECTION_ENABLED=true
