# 复制为 .env 后填入真实值
# cp .env.example .env

# LLM（聊天模型，如智谱 GLM）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=GLM-4.7-Flash
# 简单意图小模型；不填则与 LLM_MODEL 相同。演示双模型时可设 glm-4-flash
# LLM_MODEL_SIMPLE=
# LLM_ROUTE_FALLBACK_TO_LARGE=true
# LLM_ROUTE_CONFIDENCE_MIN=0.5
# 默认 false：不走系统代理（Clash 劫持智谱 HTTPS 会出现 SSL EOF）
# LLM_HTTP_TRUST_ENV=false
# LLM HTTP 超时（总/连接，秒）
# LLM_TIMEOUT_SEC=60
# LLM_CONNECT_TIMEOUT_SEC=20

# Embedding（RAG 向量；不配则退回仅 JSON 关键词检索）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# 短 JSON 不切；有长文再调这两项
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=3

# MySQL（DB_PASSWORD 必填：源码不再内置默认口令，未配置时查数工具不可用）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sky_take_out
# 商家数据隔离身份（所有查数 SQL 强制过滤；需先执行 scripts/migrate_add_merchant_id.sql）
# MERCHANT_ID=1

# 服务（可选，有默认值）
# APP_HOST=0.0.0.0
# APP_PORT=8100

# 天气 API（和风；不配 Key 工具会返回未配置提示）
# WEATHER_API_KEY=
# WEATHER_API_URL=https://devapi.qweather.com/v7
# WEATHER_DEFAULT_CITY=101040100
# WEATHER_TIMEOUT_SEC=10

# 工程护栏
# MAX_TOOL_STEPS=4
# TOKEN_BUDGET=12000
# TOOL_TIMEOUT_SEC=20
# TOOL_MAX_RETRIES=2
# IDEMPOTENCY_TTL_SEC=600

# 会话与分析阈值（B4 接线后以配置为准）
# MAX_HISTORY=20
# ANOMALY_THRESHOLD=2.0        （异常检测 Z-score 阈值）
# CORRELATION_SIGNIFICANT=0.5  （相关性中/弱分界）
# COST_RATIO_DEFAULT=0.35      （无成本字段时估算成本率）

# Supervisor
# MAX_SUPERVISOR_ROUNDS=6

# Checkpointer
# CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
# 演示断点时设为 tools（生产保持空）；恢复后可 POST /api/agent/chat/resume
# CHECKPOINT_INTERRUPT_AFTER=
# CHECKPOINT_MAX_SKIP=20

# Redis / 限流 / 对话日志
# REDIS_ENABLED=true
# REDIS_URL=redis://localhost:6379/0
# REDIS_SESSION_TTL_SEC=86400
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=30
# CHAT_LOG_ENABLED=true

# 安全（注入拦截 / 工具门禁 / API 鉴权 / CORS）
# SECURITY_INJECTION_ENABLED=true
# 非空时 /api/* 必须带 Authorization: Bearer <token>（前端 admin-web 需同步带上）；空=开发模式
# AGENT_API_TOKEN=
# CORS 白名单（逗号分隔，禁止 *）
# CORS_ORIGINS=http://localhost:8888,http://127.0.0.1:8888
# 仅部署在可信反代后置 true（允许采信 x-forwarded-for）
# TRUST_PROXY_HEADERS=false

# Langfuse（观测；不配 Key 则自动跳过，主链路不变）
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 美国区改为 https://us.cloud.langfuse.com
